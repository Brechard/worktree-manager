{
  appId: 'com.clubtidy.worktree-manager',
  productName: 'Worktree Manager',
  directories: {
    output: 'release',
    buildResources: 'resources',
  },
  icon: 'resources/icon.png',
  files: ['dist-electron', 'package.json'],
  extraResources: [
    { from: 'resources/icon.png', to: 'icon.png' },
    { from: 'resources/icon-rounded.png', to: 'icon-rounded.png' },
  ],
  mac: {
    icon: 'resources/icon.icns',
    artifactName: 'Worktree-Manager-${version}-macos-${arch}.${ext}',
    category: 'public.app-category.developer-tools',
    hardenedRuntime: true,
    notarize: true,
    target: ['dmg', 'zip'],
  },
  win: {
    artifactName: 'Worktree-Manager-${version}-windows-${arch}.${ext}',
    target: ['nsis', 'zip'],
  },
  nsis: {
    artifactName: 'Worktree-Manager-${version}-windows-${arch}.${ext}',
  },
  linux: {
    artifactName: 'Worktree-Manager-${version}-linux-${arch}.${ext}',
    category: 'Development',
    executableName: 'worktree-manager',
    target: ['AppImage', 'zip'],
  },
}
