{
  "name": "worktree-manager",
  "private": true,
  "version": "0.0.1",
  "description": "Cross-platform git worktree manager with clean UI",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "turbo run build && turbo run dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  }
}