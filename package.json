{
  "name": "worktree-manager",
  "private": true,
  "version": "0.2.1",
  "description": "Cross-platform git worktree manager with clean UI",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun run build && bun run scripts/run-tests.ts",
    "doctor": "react-doctor apps/desktop --verbose --scope full --no-cache --blocking warning --no-respect-inline-disables",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "turbo run build && turbo run dist"
  },
  "overrides": {
    "@xmldom/xmldom@^0.9.10": "0.9.12",
    "brace-expansion@<1.1.21": "1.1.21",
    "brace-expansion@<2.1.7": "2.1.7",
    "brace-expansion@^5.0.8": "5.0.12",
    "http-cache-semantics": "4.3.0",
    "js-yaml@^4.1.0": "4.3.2",
    "source-map-js": "1.2.2",
    "undici@^7.24.4": "7.30.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "react-doctor": "0.9.18",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  }
}
